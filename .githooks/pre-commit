#!/usr/bin/env bash
# Repository pre-commit hook template to block committing secrets
set -euo pipefail

# Patterns to scan for (simple heuristics)
patterns=("SUPABASE_SERVICE_KEY" "CLERK_SECRET" "SMTP_PASS" "REDIS_URL" "PRIVATE_KEY" "-----BEGIN PRIVATE KEY-----")

staged=$(git diff --cached --name-only)
for f in $staged; do
  # only check files that are being added/modified
  if [[ -f "$f" ]]; then
    for p in "${patterns[@]}"; do
      if git show :"$f" | grep -q "$p"; then
        echo "Aborting commit: found secret pattern '$p' in $f"
        exit 1
      fi
    done
  fi
done

exit 0
