{
  "name": "realtime-collab-backend",
  "version": "1.0.0",
  "description": "Real-time collaboration backend",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --ignoreDeprecations 5.0",
    "start": "node dist/server.js",
    "test:load": "artillery run ./tests/load/basic.yml",
    "smtp:verify": "tsx ./scripts/verify-smtp.ts"
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@supabase/supabase-js": "^2.103.3",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.2",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/turndown": "^5.0.6",
    "artillery": "^2.0.30",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0"
  }
}
