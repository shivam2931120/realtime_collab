PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=
NODE_ENV=development

# Session token settings
AUTH_TOKEN_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL_SECONDS=1209600

# Supabase configuration for data persistence (use the service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional Redis cache/pubsub. Leave empty for single-instance deployments.
REDIS_URL=

# Optional SMTP for share notifications
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional development bypass
# DISABLE_AUTH=true
# DEMO_USER_EMAIL=demo@example.com
