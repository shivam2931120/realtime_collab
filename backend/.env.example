PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=
NODE_ENV=development

# Session token settings
AUTH_TOKEN_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_TTL_SECONDS=1209600

# Supabase configuration for data persistence (use the service role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional Redis cache/pubsub. Leave empty for single-instance deployments.
REDIS_URL=

# Optional NVIDIA-hosted Nemotron writing assistant and semantic embeddings.
# Keep the real key on the backend only; never expose it through VITE_* variables.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Optional EmailJS delivery for share, mention, and password reset emails
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_FROM_NAME=LumaInbox
EMAILJS_REPLY_TO=
EMAILJS_MIN_INTERVAL_MS=1100

# Optional development bypass
# DISABLE_AUTH=true
# DEMO_USER_EMAIL=demo@example.com
